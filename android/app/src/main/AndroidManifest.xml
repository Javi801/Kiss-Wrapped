<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Main activity: no intent-filter — launcher entries go through aliases below -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
        </activity>

        <!-- Notebook pink (default) -->
        <activity-alias
            android:name=".AliasNotebookPink"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_notebook_pink"
            android:roundIcon="@mipmap/ic_launcher_notebook_pink"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Notebook lavender -->
        <activity-alias
            android:name=".AliasNotebookLavender"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_notebook_lavender"
            android:roundIcon="@mipmap/ic_launcher_notebook_lavender"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Notebook green -->
        <activity-alias
            android:name=".AliasNotebookGreen"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_notebook_green"
            android:roundIcon="@mipmap/ic_launcher_notebook_green"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Chart pink -->
        <activity-alias
            android:name=".AliasChartPink"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_chart_pink"
            android:roundIcon="@mipmap/ic_launcher_chart_pink"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Chart lavender -->
        <activity-alias
            android:name=".AliasChartLavender"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_chart_lavender"
            android:roundIcon="@mipmap/ic_launcher_chart_lavender"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Chart green -->
        <activity-alias
            android:name=".AliasChartGreen"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_chart_green"
            android:roundIcon="@mipmap/ic_launcher_chart_green"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Orbit pink -->
        <activity-alias
            android:name=".AliasOrbitPink"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_orbit_pink"
            android:roundIcon="@mipmap/ic_launcher_orbit_pink"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Orbit lavender -->
        <activity-alias
            android:name=".AliasOrbitLavender"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_orbit_lavender"
            android:roundIcon="@mipmap/ic_launcher_orbit_lavender"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Orbit green -->
        <activity-alias
            android:name=".AliasOrbitGreen"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_orbit_green"
            android:roundIcon="@mipmap/ic_launcher_orbit_green"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
