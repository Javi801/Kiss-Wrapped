<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Main activity: no intent-filter — launcher entries go through aliases below -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
        </activity>

        <!-- Light pink (default) -->
        <activity-alias
            android:name=".AliasLightPink"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_light_pink"
            android:roundIcon="@mipmap/ic_launcher_light_pink"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Light purple -->
        <activity-alias
            android:name=".AliasLightPurple"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_light_purple"
            android:roundIcon="@mipmap/ic_launcher_light_purple"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Golden -->
        <activity-alias
            android:name=".AliasGolden"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_golden"
            android:roundIcon="@mipmap/ic_launcher_golden"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dark purple -->
        <activity-alias
            android:name=".AliasDarkPurple"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_dark_purple"
            android:roundIcon="@mipmap/ic_launcher_dark_purple"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dark pink -->
        <activity-alias
            android:name=".AliasDarkPink"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_dark_pink"
            android:roundIcon="@mipmap/ic_launcher_dark_pink"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dark green -->
        <activity-alias
            android:name=".AliasDarkGreen"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_dark_green"
            android:roundIcon="@mipmap/ic_launcher_dark_green"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Light green -->
        <activity-alias
            android:name=".AliasLightGreen"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_light_green"
            android:roundIcon="@mipmap/ic_launcher_light_green"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
